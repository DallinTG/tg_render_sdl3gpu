#include <metal_stdlib>
#include <simd/simd.h>

using namespace metal;

struct type_UBO
{
    float4x4 mvp;
    int4 camera_step;
    float4 camera_pos;
    float step_size;
    packed_float3 _padding;
    float2 viewport_size;
    float2 _padding_2;
};

struct Vertex
{
    float4 pos;
    int4 _step;
    float4 color;
    float4 uv_img_layer;
    float4 color2;
};

struct type_StructuredBuffer_Vertex
{
    Vertex _m0[1];
};

struct type_StructuredBuffer_uint
{
    uint _m0[1];
};

struct main0_out
{
    float4 out_var_TEXCOORD0 [[user(locn0)]];
    float2 out_var_TEXCOORD1 [[user(locn1)]];
    uint out_var_TEXCOORD2 [[user(locn2)]];
    uint out_var_TEXCOORD3 [[user(locn3)]];
    float4 out_var_TEXCOORD4 [[user(locn4)]];
    float4 gl_Position [[position]];
};

vertex main0_out main0(constant type_UBO& UBO [[buffer(0)]], const device type_StructuredBuffer_Vertex& Vertices [[buffer(1)]], const device type_StructuredBuffer_uint& Indices [[buffer(2)]], uint gl_VertexIndex [[vertex_id]])
{
    main0_out out = {};
    out.gl_Position = UBO.mvp * float4(((float3(Vertices._m0[Indices._m0[gl_VertexIndex]]._step.xyz - UBO.camera_step.xyz) * UBO.step_size) + Vertices._m0[Indices._m0[gl_VertexIndex]].pos.xyz) - UBO.camera_pos.xyz, Vertices._m0[Indices._m0[gl_VertexIndex]].pos.w);
    out.out_var_TEXCOORD0 = Vertices._m0[Indices._m0[gl_VertexIndex]].color;
    out.out_var_TEXCOORD1 = Vertices._m0[Indices._m0[gl_VertexIndex]].uv_img_layer.xy;
    out.out_var_TEXCOORD2 = as_type<uint>(Vertices._m0[Indices._m0[gl_VertexIndex]].uv_img_layer.z);
    out.out_var_TEXCOORD3 = as_type<uint>(Vertices._m0[Indices._m0[gl_VertexIndex]].uv_img_layer.w);
    out.out_var_TEXCOORD4 = Vertices._m0[Indices._m0[gl_VertexIndex]].color2;
    return out;
}

